{
  "name": "@tandem/relay",
  "version": "0.3.1",
  "description": "Tandem 中继服务：让不在同一局域网的客户端经出站隧道连到 Host",
  "type": "module",
  "main": "dist/cli.js",
  "bin": {
    "tandem-relay": "dist/cli.js"
  },
  "exports": {
    "./wire": {
      "types": "./dist/wire.d.ts",
      "default": "./dist/wire.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./tunnel": {
      "types": "./dist/tunnel.d.ts",
      "default": "./dist/tunnel.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    }
  },
  "scripts": {
    "build": "tsc -p .",
    "dev": "tsx watch src/cli.ts"
  },
  "dependencies": {
    "fastify": "^5.0.0",
    "ws": "^8.18.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.2",
    "tsx": "^4.0.0",
    "typescript": "^5.9.3"
  }
}
