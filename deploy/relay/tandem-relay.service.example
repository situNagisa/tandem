[Unit]
Description=Tandem Relay
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tandem-relay
Group=tandem-relay
WorkingDirectory=/opt/tandem
Environment=NODE_ENV=production
ExecStart=/usr/bin/node /opt/tandem/packages/relay/dist/cli.js --host 127.0.0.1 --port 7950 --trust-proxy --data /var/lib/tandem-relay
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
